{
  "crons": [
    {
      "path": "/api/cron/ig-generate",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/ig-publish",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/ig-refresh-token",
      "schedule": "0 12 */50 * *"
    }
  ],
  "functions": {
    "app/api/ig/render-post/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  }
}
